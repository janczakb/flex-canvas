{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true, "useDefineForClassFields": true, "declaration": true,
    "outDir": "dist", "rootDir": "src"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
